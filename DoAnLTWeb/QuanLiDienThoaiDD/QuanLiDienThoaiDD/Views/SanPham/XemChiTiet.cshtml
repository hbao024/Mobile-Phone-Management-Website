@model QuanLiDienThoaiDD.Models.SANPHAM
@{
    ViewBag.Title = Model.TenSanPham;
    Layout = "~/Views/Shared/UserLayout.cshtml";
    var dsBienThe = Model.BIENSANPHAMs.Where(b => b.TrangThai == true).ToList();
    var dsCungLoai = ViewBag.CungLoai as List<QuanLiDienThoaiDD.Models.SANPHAM>;
}

<h3 class="mb-3">@Model.TenSanPham</h3>

<div class="row g-4">
    <div class="col-md-5">
        <div class="card border-0 shadow-sm">
            <div class="p-3 text-center">
                <img id="anhChinh" src="@Url.Content("~" + dsBienThe.First().HinhAnhUrl)"
                     class="img-fluid" style="max-height:320px; object-fit:contain;" />
            </div>
        </div>
    </div>

    <div class="col-md-7">
        <h4 class="text-danger fw-bold mb-3">Từ @string.Format("{0:N0}", dsBienThe.Min(b => b.GiaBan)) đ</h4>

        <ul class="list-unstyled mb-4">
            <li class="mb-2"><b>Loại:</b> @Model.LOAISANPHAM.TenLoai</li>
            <li class="mb-2"><b>Bảo hành:</b> @Model.BaoHanhThang tháng</li>
            <li class="mb-2"><b>Mô tả:</b> @Model.MoTa</li>
        </ul>

        <h5 class="mb-2">Các phiên bản <small class="text-muted fs-6">(bấm vào màu để xem ảnh)</small></h5>
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Màu sắc</th>
                        <th>RAM</th>
                        <th>Bộ nhớ</th>
                        <th>Giá bán</th>
                        <th></th>
                    </tr>
                </thead>
                @foreach (var b in dsBienThe)
                {
                    <tr>
                        <td>
                            <button type="button" class="btn btn-sm btn-outline-dark"
                                    onclick="doiAnh('@Url.Content("~" + b.HinhAnhUrl)')">
                                @b.MauSac
                                </button>
                            </td>
                            <td>@(b.RAMGB.HasValue ? b.RAMGB + " GB" : "-")</td>
                            <td>@(b.BoNhoGB.HasValue ? b.BoNhoGB + " GB" : "-")</td>
                            <td class="text-danger fw-bold">@string.Format("{0:N0}", b.GiaBan) đ</td>
                            <td>@Html.ActionLink("Chọn mua", "ThemMatHang", "GioHang", new { maBienSanPham = b.MaBienSanPham }, new { @class = "btn btn-warning btn-sm" })</td>
                        </tr>
                    }
            </table>
        </div>
    </div>
</div>

@if (dsCungLoai != null && dsCungLoai.Count > 0)
{
    <h5 class="mt-5 mb-3">Sản phẩm cùng loại</h5>
    <div class="row g-3">
        @foreach (var s in dsCungLoai)
        {
            <div class="col-lg-4 col-md-6">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="p-3 text-center">
                        <img src="@Url.Content("~" + s.BIENSANPHAMs.First().HinhAnhUrl)"
                             class="img-fluid" style="height:150px; object-fit:contain;" />
                    </div>
                    <div class="card-body d-flex flex-column text-center pt-0">
                        <h6 class="card-title fw-bold">@s.TenSanPham</h6>
                        <p class="text-danger fw-bold mb-3">@string.Format("{0:N0}", s.BIENSANPHAMs.Min(b => b.GiaBan)) đ</p>
                        @Html.ActionLink("Chi tiết", "XemChiTiet", "SanPham", new { id = s.MaSanPham }, new { @class = "btn btn-warning btn-sm mt-auto" })
                    </div>
                </div>
            </div>
        }
    </div>
}

<script>
        function doiAnh(duongDan) {
            document.getElementById("anhChinh").src = duongDan;
        }
</script>