@model List<QuanLiDienThoaiDD.Models.SANPHAM>
@{
    ViewBag.Title = "Lọc sản phẩm";
    Layout = "~/Views/Shared/UserLayout.cshtml";
    var dsLoai = ViewBag.LoaiSanPham as List<QuanLiDienThoaiDD.Models.LOAISANPHAM>;
    string maLoaiChon = ViewBag.MaLoai as string;
}

<h4 class="mb-3">Tìm theo loại và giá</h4>

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body">
        <form action="@Url.Action("LocSanPham", "SanPham")" method="get" class="row g-2">
            <div class="col-md-4">
                <select name="maLoai" class="form-select">
                    <option value="">-- Tất cả loại --</option>
                    @foreach (var lsp in dsLoai)
                    {
                        <option value="@lsp.MaLoai" @(lsp.MaLoai == maLoaiChon ? "selected" : "")>@lsp.TenLoai</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <input type="number" name="giaTu" class="form-control" placeholder="Giá từ" value="@ViewBag.GiaTu" />
            </div>
            <div class="col-md-3">
                <input type="number" name="giaDen" class="form-control" placeholder="Giá đến" value="@ViewBag.GiaDen" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-dark w-100">Lọc</button>
            </div>
        </form>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">Không có sản phẩm phù hợp.</div>
}

<div class="row g-3">
    @foreach (var sp in Model)
    {
        <div class="col-lg-4 col-md-6">
            <div class="card h-100 border-0 shadow-sm">
                <div class="p-3 text-center">
                    <img src="@Url.Content("~" + sp.BIENSANPHAMs.First().HinhAnhUrl)"
                         class="img-fluid" style="height:180px; object-fit:contain;" />
                </div>
                <div class="card-body d-flex flex-column text-center pt-0">
                    <h6 class="card-title fw-bold">@sp.TenSanPham</h6>
                    <p class="text-danger fw-bold mb-3">@string.Format("{0:N0}", sp.BIENSANPHAMs.Min(b => b.GiaBan)) đ</p>
                    @Html.ActionLink("Chi tiết", "XemChiTiet", "SanPham", new { id = sp.MaSanPham }, new { @class = "btn btn-warning btn-sm mt-auto" })
                </div>
            </div>
        </div>
    }
</div>