@model List<QuanLiDienThoaiDD.Models.DONHANG>
@{
    ViewBag.Title = "Lịch sử mua hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h3 class="my-3">Lịch sử mua hàng</h3>

@if (Model.Count == 0)
{
    <div class="text-center py-5">
        <p class="fs-5 text-muted">Bạn chưa có đơn hàng nào.</p>
        @Html.ActionLink("Mua sắm ngay", "Index", "SanPham", null, new { @class = "btn btn-primary" })
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Mã đơn</th>
                        <th>Ngày đặt</th>
                        <th>Trạng thái</th>
                        <th>Thanh toán</th>
                        <th>Tổng tiền</th>
                        <th></th>
                    </tr>
                </thead>
                @foreach (var dh in Model)
                {
                    string mau = "bg-secondary";
                    if (dh.TrangThaiDonHang == "CHO_XAC_NHAN") { mau = "bg-warning text-dark"; }
                    if (dh.TrangThaiDonHang == "DA_GIAO") { mau = "bg-success"; }
                    if (dh.TrangThaiDonHang == "DA_HUY") { mau = "bg-danger"; }

                    <tr>
                        <td class="fw-bold">@dh.MaDonHang</td>
                        <td>@dh.NgayDat.ToString("dd/MM/yyyy HH:mm")</td>
                        <td><span class="badge @mau">@dh.TrangThaiDonHang.Replace("_", " ")</span></td>
                        <td>@dh.PhuongThucThanhToan - @dh.TrangThaiThanhToan.Replace("_", " ")</td>
                        <td class="text-danger fw-bold">@string.Format("{0:N0}", dh.TongTien) đ</td>
                        <td>@Html.ActionLink("Xem chi tiết", "ChiTiet", "LichSuMuaHang", new { ma = dh.MaDonHang }, new { @class = "btn btn-sm btn-outline-primary" })</td>
                    </tr>
                }
            </table>
        </div>
    </div>
}