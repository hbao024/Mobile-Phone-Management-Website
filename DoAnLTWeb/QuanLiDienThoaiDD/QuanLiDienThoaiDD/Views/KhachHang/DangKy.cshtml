@model QuanLiDienThoaiDD.Models.DangKyModel
@{
    ViewBag.Title = "Đăng ký";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center my-4">
    <div class="col-md-6">
        <h3 class="mb-3">Đăng ký tài khoản</h3>

        @using (Html.BeginForm("DangKy", "KhachHang", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="mb-2">
                <label>Họ tên</label>
                @Html.TextBoxFor(m => m.TenKH, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.TenKH, "", new { @class = "text-danger" })
            </div>
            <div class="mb-2">
                <label>Email</label>
                @Html.TextBoxFor(m => m.Email, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
            </div>
            <div class="mb-2">
                <label>Số điện thoại</label>
                @Html.TextBoxFor(m => m.DienThoai, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.DienThoai, "", new { @class = "text-danger" })
            </div>
            <div class="mb-2">
                <label>Địa chỉ</label>
                @Html.TextBoxFor(m => m.DiaChi, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.DiaChi, "", new { @class = "text-danger" })
            </div>
            <div class="mb-2">
                <label>Tên đăng nhập</label>
                @Html.TextBoxFor(m => m.TenDangNhap, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.TenDangNhap, "", new { @class = "text-danger" })
            </div>
            <div class="mb-2">
                <label>Mật khẩu</label>
                @Html.PasswordFor(m => m.MatKhau, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.MatKhau, "", new { @class = "text-danger" })
            </div>
            <div class="mb-3">
                <label>Nhập lại mật khẩu</label>
                @Html.PasswordFor(m => m.NhapLaiMatKhau, new { @class = "form-control" })
                @Html.ValidationMessageFor(m => m.NhapLaiMatKhau, "", new { @class = "text-danger" })
            </div>

            <button type="submit" class="btn btn-primary">Đăng ký</button>
        }
    </div>
</div>