@{
    ViewBag.Title = "Trang chủ";
}

<main class="storefront-home">
    <section class="hero-section">
        <div class="hero-copy">
            <span class="eyebrow">MOBILEHUB STORE</span>
            <h1>Công nghệ mới,<br /><span>trải nghiệm khác biệt.</span></h1>
            <p>Quản lý và mua sắm điện thoại di động trong một nền tảng đơn giản, rõ ràng và hiện đại.</p>
            <a href="@Url.Action("Index", "SanPham")" class="btn btn-primary btn-lg">Khám phá sản phẩm</a>
        </div>
        <div class="hero-device" aria-hidden="true">
            <div class="device-glow"></div>
            <div class="device-shape"><div class="device-camera"></div></div>
        </div>
    </section>
</main>
