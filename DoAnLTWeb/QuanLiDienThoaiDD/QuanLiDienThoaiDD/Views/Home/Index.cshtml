@{
    ViewBag.Title = "Trang chủ";
}

<main class="storefront-home">
    <section class="hero-section">
        <div class="hero-copy">
            <span class="eyebrow">MOBILEHUB STORE</span>
            <h1>Công nghệ mới,<br /><span>trải nghiệm khác biệt.</span></h1>
            <p>Quản lý và mua sắm điện thoại di động trong một nền tảng đơn giản, rõ ràng và hiện đại.</p>
            <a href="#modules" class="btn btn-primary btn-lg">Khám phá hệ thống</a>
        </div>
        <div class="hero-device" aria-hidden="true">
            <div class="device-glow"></div>
            <div class="device-shape"><div class="device-camera"></div></div>
        </div>
    </section>

    <section id="modules" class="module-grid">
        <div class="module-card"><span class="module-number">01</span><h2>Danh mục sản phẩm</h2><p>Quản lý điện thoại, thương hiệu, phiên bản và thông tin bảo hành.</p></div>
        <div class="module-card"><span class="module-number">02</span><h2>Đặt hàng trực tuyến</h2><p>Khách hàng có thể đăng nhập, chọn sản phẩm và theo dõi đơn hàng.</p></div>
        <div class="module-card"><span class="module-number">03</span><h2>Quản trị cửa hàng</h2><p>Dashboard tập trung cho đơn hàng, doanh thu và cảnh báo tồn kho.</p></div>
    </section>
</main>
