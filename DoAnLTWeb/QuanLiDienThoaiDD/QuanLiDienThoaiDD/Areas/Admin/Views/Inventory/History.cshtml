@model IEnumerable<QuanLiDienThoaiDD.Models.GIAODICHKHO>
@{ ViewBag.Title = "Lịch sử điều chỉnh"; }
<h1>Lịch sử điều chỉnh: @ViewBag.SKU</h1>
@if (TempData["InventorySuccess"] != null) { <p role="status">@TempData["InventorySuccess"]</p> }
<p>@ViewBag.Total giao dịch. Trang @ViewBag.Page / @ViewBag.Pages.</p>
<table class="table"><thead><tr><th>Mã giao dịch</th><th>Thời gian</th><th>Loại</th><th>Số lượng</th><th>Tồn trước</th><th>Tồn sau</th><th>Nhân viên</th><th>Lý do</th></tr></thead><tbody>
@foreach (var row in Model)
{
    <tr><td>@row.MaGiaoDich</td><td>@row.NgayGiaoDich.ToString("dd/MM/yyyy HH:mm:ss")</td><td>@(row.LoaiGiaoDich == "DIEU_CHINH_TANG" ? "Tăng tồn" : "Giảm tồn")</td><td>@row.SoLuong</td><td>@row.SoLuongTruoc</td><td>@row.SoLuongSau</td><td>@row.MaNV</td><td>@(row.GhiChu != null && row.GhiChu.StartsWith("INV1:") && row.GhiChu.Length >= 38 ? row.GhiChu.Substring(38) : row.GhiChu)</td></tr>
}
@if (!Model.Any()) { <tr><td colspan="8">Chưa có giao dịch điều chỉnh.</td></tr> }
</tbody></table>
@if (ViewBag.Page > 1) { @Html.ActionLink("Trước", "History", new { id = (string)ViewBag.VariantId, page = (int)ViewBag.Page - 1 }) }
@if (ViewBag.Page < ViewBag.Pages) { @Html.ActionLink("Sau", "History", new { id = (string)ViewBag.VariantId, page = (int)ViewBag.Page + 1 }) }
<p>@Html.ActionLink("Điều chỉnh mới", "Adjust", new { id = (string)ViewBag.VariantId }) | @Html.ActionLink("Về tồn kho", "Index")</p>
