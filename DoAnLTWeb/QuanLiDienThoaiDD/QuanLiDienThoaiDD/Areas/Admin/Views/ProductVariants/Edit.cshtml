@model QuanLiDienThoaiDD.Areas.Admin.ViewModels.ProductVariantEditViewModel
@{ ViewBag.Title = "Chỉnh sửa biến thể"; }
<h1>Chỉnh sửa biến thể: @ViewBag.ProductName</h1>
<p>Mã biến thể: <strong>@ViewBag.VariantId</strong>. Sản phẩm: <strong>@ViewBag.ProductId</strong> (không thể thay đổi).</p>
@using (Html.BeginForm("Edit", "ProductVariants", new { area = "Admin", productId = (string)ViewBag.ProductId, id = (string)ViewBag.VariantId }, FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger", role = "alert" })
    @Html.Partial("_Fields", Model)
    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
    @Html.ActionLink("Về danh sách", "Index", new { productId = (string)ViewBag.ProductId }, new { @class = "btn btn-secondary" })
}
