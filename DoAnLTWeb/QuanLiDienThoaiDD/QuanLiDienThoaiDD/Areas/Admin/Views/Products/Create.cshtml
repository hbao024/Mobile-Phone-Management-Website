@model QuanLiDienThoaiDD.Areas.Admin.ViewModels.ProductViewModel
@{ ViewBag.Title = "Thêm sản phẩm"; }
<h1>Thêm sản phẩm</h1>
@using (Html.BeginForm("Create", "Products", new { area = "Admin" }, FormMethod.Post, null))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger", role = "alert" })
    <div class="mb-3">
        @Html.LabelFor(m => m.MaSanPham, new { @class = "form-label" })
        @Html.TextBoxFor(m => m.MaSanPham, new { @class = "form-control", maxlength = "20", required = "required" })
        <small>Mã tối đa 20 ký tự: chữ ASCII, số, _ hoặc -. Không đổi sau khi tạo.</small>
        @Html.ValidationMessageFor(m => m.MaSanPham, "", new { @class = "text-danger" })
    </div>
    @Html.Partial("_Fields", Model)
    <button type="submit" class="btn btn-primary">Thêm sản phẩm</button>
    @Html.ActionLink("Về danh sách", "Index", null, new { @class = "btn btn-secondary" })
}
